# ============================================================
# QuickSync Environment Configuration
# ============================================================

# Database Configuration (PostgreSQL in Docker / SQLite local fallback)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/quicksync_db

# Redis URL (Optional for Caching)
REDIS_URL=redis://localhost:6379/0

# JWT Security Secrets
JWT_SECRET=quicksync_super_secret_jwt_key_998877665544332211
JWT_REFRESH_SECRET=quicksync_super_secret_refresh_jwt_key_1122334455

# QuickCommerce Live API Authentication
QUICKCOMMERCE_BASE_URL=https://api.quickcommerceapi.com
QUICKCOMMERCE_API_KEY=qc_live_your_actual_api_key_here

# Default Geolocation Coordinates (Bangalore Darkstore Default)
DEFAULT_CITY=Bangalore
DEFAULT_AREA=Indiranagar
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
DEFAULT_PINCODE=560001

# Pipeline Resiliency & Polling Timing
SYNC_INTERVAL_SECONDS=60
API_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# CORS Whitelist (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
